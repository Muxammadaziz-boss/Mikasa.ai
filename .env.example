# ==========================================
# MIKASA AI v8.0.0 — CONFIGURATION TEMPLATE
# ==========================================

# Server Settings
HOST=127.0.0.1
PORT=8000
ENVIRONMENT=development

# ========== API Kalitlari ==========
# Bu faylni .env ga nusxalab, haqiqiy kalitlarni yozing
# .env HECH QACHON Git ga push qilinmasligi kerak!

GOOGLE_API_KEY=your_google_api_key_here
OPENWEATHER_API_KEY=your_openweather_api_key_here
ADMIN_PAROL='your_admin_password_here'

# OpenRouter API
OPENROUTER_API_KEY=your_openrouter_api_key_here
OPENROUTER_MODEL=google/gemini-2.5-flash

# Telegram Remote Control Gateway
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
TELEGRAM_ADMIN_ID=your_telegram_numeric_id_here

# Wake-on-LAN Settings
WOL_BROADCAST_IP=255.255.255.255
WOL_PORT=9
TARGET_PC_MAC=00:11:22:33:44:55

# Security & Permissions
ENVELOPE_TTL_SECONDS=60
REQUIRE_HIGH_RISK_CONFIRMATION=true
