# ==============================================================================
# Mikasa AI v8.0.0 — Environment Configuration Example
# ==============================================================================

# Supabase New API Key Architecture (Phase 41+)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
SUPABASE_SECRET_KEY=sb_secret_...

# Legacy Keys (Supported for backward compatibility)
# SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
# SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
# SUPABASE_JWT_SECRET=optional-legacy-symmetric-jwt-secret

# Telegram Bot Integration (Phase 39 / Phase 46 Production)
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=MikasaUniversalBot
TELEGRAM_WEBHOOK_SECRET=
TELEGRAM_USE_WEBHOOK=true
TELEGRAM_ADMIN_USER_ID=

# Railway / Production URLs
# RAILWAY_PUBLIC_DOMAIN is set automatically by Railway (e.g. your-service.up.railway.app)
RAILWAY_PUBLIC_DOMAIN=
MIKASA_PUBLIC_URL=
MIKASA_BACKEND_URL=

# Mikasa API Server & Security
MIKASA_API_HOST=127.0.0.1
MIKASA_API_PORT=18420
MIKASA_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,tauri://localhost
ENVIRONMENT=development
