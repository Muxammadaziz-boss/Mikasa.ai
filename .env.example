# ================================================================
# MIKASA AI v8.0.0 — PHASE 36 CONFIGURATION TEMPLATE
# ================================================================
# Ushbu faylni .env ga nusxalang va o'z konfiguratsiyalaringizni kiriting.
# DIQQAT: .env fayli hech qachon Git ga commit qilinmasligi shart!

# ========== Server & Gateway ==========
HOST=127.0.0.1
PORT=8000
ENVIRONMENT=development
GATEWAY_HOST=127.0.0.1
GATEWAY_PORT=8000

# ========== LLM & AI API Keys ==========
GOOGLE_API_KEY=your_google_api_key_here
OPENWEATHER_API_KEY=your_openweather_api_key_here
ADMIN_PAROL=your_admin_password_here
OPENROUTER_API_KEY=your_openrouter_api_key_here
OPENROUTER_MODEL=google/gemini-2.5-flash

# ========== Telegram Remote Gateway ==========
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
TELEGRAM_ADMIN_ID=your_telegram_numeric_id_here
TELEGRAM_ALLOWED_USERS=123456789,987654321

# ========== Wake-on-LAN (WoL) ==========
WOL_ENABLED=true
WOL_BROADCAST_ADDRESS=255.255.255.255
WOL_BROADCAST_IP=255.255.255.255
WOL_PORT=9
WOL_RETRY_COUNT=3
WOL_TIMEOUT=10.0
TARGET_PC_MAC=00:11:22:33:44:55

# ========== PC Agent & Heartbeat ==========
AGENT_HEARTBEAT_INTERVAL=10.0
AGENT_MAX_BACKOFF=30.0
HEARTBEAT_STALE_TIMEOUT=60.0

# ========== Security, Rate Limiting & Idempotency ==========
ENVELOPE_TTL_SECONDS=300
CONFIRMATION_TTL_SECONDS=60
REQUIRE_HIGH_RISK_CONFIRMATION=true
RATE_LIMIT_MAX_REQUESTS=30
RATE_LIMIT_WINDOW_SECONDS=60.0
